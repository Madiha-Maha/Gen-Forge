# GEMINI_API_KEY: Default Google Gemini API key (automatically injected in AI Studio)
GEMINI_API_KEY="AIzaSy_fake_gemini_api_key_example"

# LLM Provider Configuration (OpenAI-compatible endpoints or Gemini fallback)
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY="sk-fake_openai_api_key_example"
LLM_MODEL="gemini-3.8-flash"
LLM_MODEL_BUILD="gemini-3.8-flash"
LLM_MODEL_ASK="gemini-3.8-flash"

# Scanner Service URL (FastAPI CodeBERT service)
SCANNER_URL="http://localhost:8000"

# Optional Search Provider for Ask Mode ('gemini' uses native search grounding, or 'serper', 'tavily')
SEARCH_PROVIDER="gemini"
SEARCH_API_KEY=""

# Rate Limiting & Spending Cap
PER_IP_PER_MINUTE="10"
PER_IP_PER_DAY="100"
GLOBAL_PER_DAY="1000"

# Optional Deployments
VERCEL_TOKEN=""

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

